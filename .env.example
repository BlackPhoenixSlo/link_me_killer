# Environment contract for compose.yaml. On the VPS copy this to an untracked .env and fill it in.
# Tests use the committed tests/e2e.env instead.
# On the VPS also set COMPOSE_FILE=compose.yaml:compose.vps.yaml, which adds Traefik's routers to Caddy (compose.vps.yaml).

# Caddy's site. On the VPS "https://": one catch-all with on-demand TLS that serves every hostname the app's TLS Ask admits
# (the PRIMARY_HOSTS below, Spare Domains and Custom Domains), so Phase 2's v2 host goes into PRIMARY_HOSTS (Caddyfile).
# ":80" in tests: plain HTTP for any Host, no certificate.
SITE_ADDRESS=
HTTP_PORT=80
HTTPS_PORT=443
# Published on 127.0.0.1 only; reach the admin UI through an SSH tunnel.
PB_PORT=8090
# Required.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
REVEAL_LIMIT_PER_MINUTE=60
# Required. ofl.ink's own hosts, comma-separated (Phase 5 spec, PRIMARY_HOSTS): served with no database lookup and always
# confirmed by the TLS Ask. On the VPS: ofl.ink, plus www.ofl.ink if it exists, plus Phase 2's v2 host.
PRIMARY_HOSTS=
# The addresses Caddy accepts a PROXY protocol header from, as space-separated CIDRs; empty is off (tests). On the VPS,
# Traefik (n8n-traefik-1) fronts Caddy by TLS passthrough and sends the header, so set the subnet of Traefik's Docker network:
#   for n in $(docker inspect n8n-traefik-1 --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'); do
#     docker network inspect "$n" --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}'; done
# e.g. PROXY_PROTOCOL_FROM=172.18.0.0/16. Check: two separate clients each reach their own 429 (ticket 23).
# ASSUMPTION: Caddy sees Traefik's connections to its published HTTPS_PORT coming from Traefik's container address, inside
# that subnet (not observed: the live VPS is out of bounds). Overturned if the check shows one shared 429: Caddy then sees
# another source (e.g. its own network's gateway, through Docker's userland proxy), and that address goes here instead. A
# wrong range breaks nothing else: Caddy reads and drops a header from an address outside it.
PROXY_PROTOCOL_FROM=
# Cloudflare's published ranges, as space-separated CIDRs; empty is off (tests). On the VPS, the Operator fills it at the
# Cutover's step 1 (RUN.md) with the output of:
#   { curl -s https://www.cloudflare.com/ips-v4; echo; curl -s https://www.cloudflare.com/ips-v6; } | xargs
# Set, Caddy's production catch-all trusts these ranges for the Visitor's address and keeps CF-IPCountry and CF-Region-Code
# only from them, and drops v1's location headers (Caddyfile, the Cloudflare lines). Refresh it by the same command if
# Cloudflare changes its ranges.
CLOUDFLARE_RANGES=
