#!/usr/bin/env node
'use strict';
// v1 Import: import-v1 --site <dir> [--site <dir>]...
// Each <dir> is laid out like the v1 Snapshot: api/profiles/*.json, netlify/functions/secrets.json, images under /images/.
// Every file is read and validated before anything is written. No printed line ever holds a Destination:
// lines name a file, Username, card position or secrets key, and parse errors are never echoed.
// Exit 0: written, ending with `imported: <n> Profiles, <n> Links, <n> images, <n> warnings`.
// Exit 1: refused, nothing written. Exit 2: failed while writing (`write failed: <fixed reason>`).
// It runs inside the app image with its site mounted read-only for that run only (compose.yaml, app service):
//   docker compose run --rm -v "$PWD/linkme_clone3:/v1:ro" app import-v1 --site /v1
// Refusals and `write failed:` go to stderr, repair and skip lines to stdout.
// ASSUMPTION: a site without api/profiles/ or netlify/functions/secrets.json is refused, as is an unreadable file, an image path outside /images/ or with a `..` segment, and a card without a string id or title (rung 4: never import guessed data). Overturned if the Operator wants any of these imported leniently.
// ASSUMPTION: a non-WebP image is refused for now, against the spec's "convert rather than refuse" (phase-02-vps-foundation.md:341), because the Image pipeline does not exist yet (rung 4: refusing writes nothing). Ticket 21 removes this refusal when it adds the conversion.
// ASSUMPTION: an unexpected error anywhere outside the write phase prints one fixed line, never the error or its properties (they can carry an input url), and exits 1, since nothing was written (rung 4). Overturned if the Operator needs the error detail; it would then go to a log no Destination can reach.
// ASSUMPTION: no Link Id is minted here; PocketBase's autogenerated linkId gives each new Link a fresh one on create (rung 5). Overturned if the import must choose Link Ids itself.
// ASSUMPTION: the summary's warning count is every repair, skip, drop, missing-image and no-destination line printed before it (rung 5: one count of the lines the Operator should read). Overturned if repairs must be counted apart from warnings.
const fs = require('node:fs');
const path = require('node:path');

const USERNAME = /^[a-z0-9_]+$/;
const MODES = new Set(['direct', 'escape_ig', 'deeplink']);
const DEFAULT_MODE = 'escape_ig';
// Absolute http(s) URL or root-relative path: the same source as links.destination's pattern (1791140002_links.js).
// JS's \s covers more than Go RE2's, so the import refuses at least what PocketBase refuses.
const DESTINATION = new RegExp(String.raw`^(https?://[^\s\\/]|/[^\s\\/])[^\s\\]*$`);
const N8N_EXPRESSION = /\$\(|\{\{/;

const isObject = (v) => v !== null && typeof v === 'object' && !Array.isArray(v);

function parseArgs(argv) {
  const sites = [];
  for (let i = 0; i < argv.length; i += 2) {
    if (argv[i] !== '--site' || !argv[i + 1]) return null;
    sites.push(argv[i + 1]);
  }
  return sites.length ? sites : null;
}

// A relative url is resolved the way v1's page at /{username} resolved it: against the root.
function rootRelative(url) {
  if (typeof url !== 'string' || url === '' || url.startsWith('/') || /^[a-z][a-z0-9+.-]*:/i.test(url)) return url;
  try {
    const u = new URL(url, 'http://v1.invalid/');
    return u.pathname + u.search + u.hash;
  } catch {
    return null; // the WHATWG parser's error carries the url, so it is dropped here and refused by its fixed reason
  }
}

function isWebp(file) {
  const fd = fs.openSync(file, 'r');
  const head = Buffer.alloc(12);
  try {
    fs.readSync(fd, head, 0, 12, 0);
  } finally {
    fs.closeSync(fd);
  }
  return head.toString('latin1', 0, 4) === 'RIFF' && head.toString('latin1', 8, 12) === 'WEBP';
}

function planImport(sites) {
  const problems = [];
  const notes = [];
  const profiles = [];
  const bad = (file, reason) => {
    problems.push(`invalid v1 file: ${file}: ${reason}`);
  };
  const usernames = new Map(); // Username -> file, across all sites

  // Parsed as it is; a file that fails is retried once with only the trailing commas before } or ] removed.
  // Reads a file's bytes, or names it unreadable (a directory, no permission) without echoing the error.
  function readBytes(file) {
    try {
      return fs.readFileSync(file);
    } catch {
      return bad(file, 'unreadable');
    }
  }

  function readJson(file, repairable) {
    const bytes = readBytes(file);
    return bytes ? parseJson(file, bytes, repairable) : undefined;
  }

  function parseJson(file, bytes, repairable) {
    const text = bytes.toString('utf8');
    try {
      return { value: JSON.parse(text), repaired: false };
    } catch {
      if (!repairable) return bad(file, 'not valid JSON');
    }
    try {
      return { value: JSON.parse(text.replace(/,(\s*[}\]])/g, '$1')), repaired: true };
    } catch {
      return bad(file, 'not valid JSON, even after the trailing-comma repair');
    }
  }

  for (const site of sites) {
    const profilesDir = path.join(site, 'api', 'profiles');
    const secretsFile = path.join(site, 'netlify', 'functions', 'secrets.json');

    let secrets = {};
    if (!fs.existsSync(secretsFile)) bad(secretsFile, 'missing');
    else {
      const read = readJson(secretsFile, false);
      if (read && !isObject(read.value)) bad(secretsFile, 'not a JSON object');
      else if (read) secrets = read.value;
    }

    if (!fs.existsSync(profilesDir)) {
      bad(profilesDir, 'missing');
      continue;
    }

    // Case twins: equal bytes are skipped once; differing bytes refuse the run.
    const groups = new Map();
    let entries;
    try {
      entries = fs.readdirSync(profilesDir);
    } catch {
      bad(profilesDir, 'unreadable');
      continue;
    }
    for (const name of entries.filter((n) => n.endsWith('.json')).sort()) {
      const key = name.toLowerCase();
      groups.set(key, [...(groups.get(key) || []), name]);
    }
    const kept = []; // [name, bytes]: each kept file is read once, here
    for (const group of groups.values()) {
      const keep = group.find((n) => n === n.toLowerCase()) || group[0];
      const keptBytes = readBytes(path.join(profilesDir, keep));
      if (!keptBytes) continue;
      for (const twin of group.filter((n) => n !== keep)) {
        const twinFile = path.join(profilesDir, twin);
        const twinBytes = readBytes(twinFile);
        if (!twinBytes) continue;
        if (twinBytes.equals(keptBytes)) notes.push(`skipped: ${twinFile}: case twin of ${keep}`);
        else bad(twinFile, `case twin of ${keep} with different bytes`);
      }
      kept.push([keep, keptBytes]);
    }

    const image = (file, field, value) => {
      if (value === undefined || value === null || value === '') return null;
      if (typeof value !== 'string' || !value.startsWith('/images/') || value.split('/').includes('..')) {
        bad(file, `${field} is not an /images/ path`);
        return null;
      }
      const abs = path.join(site, value);
      if (!fs.existsSync(abs)) {
        notes.push(`missing image: ${file}: ${field}`);
        return null;
      }
      let webp;
      try {
        webp = isWebp(abs);
      } catch {
        bad(file, `${field} is unreadable`);
        return null;
      }
      if (!webp) {
        bad(file, `${field} is not WebP`);
        return null;
      }
      return abs;
    };

    const usedKeys = new Set();
    for (const [name, bytes] of kept) {
      const file = path.join(profilesDir, name);
      const username = name.slice(0, -'.json'.length).toLowerCase();
      if (!USERNAME.test(username)) {
        bad(file, 'the file name is not a valid Username');
        continue;
      }
      if (usernames.has(username)) {
        bad(file, `Username ${username} is also in ${usernames.get(username)}`);
        continue;
      }
      usernames.set(username, file);

      const read = parseJson(file, bytes, true);
      if (!read) continue;
      if (read.repaired) notes.push(`repaired: ${file}: trailing comma`);
      if (!isObject(read.value)) {
        bad(file, 'not a JSON object');
        continue;
      }
      const { profile: p, links } = read.value;
      if (!isObject(p)) bad(file, 'no profile object');
      if (!Array.isArray(links)) bad(file, 'no links array');
      if (!isObject(p) || !Array.isArray(links)) continue;

      let displayName = typeof p.displayName === 'string' ? p.displayName : '';
      if (N8N_EXPRESSION.test(displayName)) {
        displayName = username;
        notes.push(`repaired: ${file}: display name`);
      }
      let mode = DEFAULT_MODE;
      if (p.mode !== undefined && p.mode !== null && p.mode !== '') {
        if (MODES.has(p.mode)) mode = p.mode;
        else bad(file, 'profile mode is not a Mode');
      }

      const occurrences = new Map();
      const planned = [];
      links.forEach((l, i) => {
        const card = i + 1;
        if (!isObject(l)) return bad(file, `card ${card} is not an object`);
        if (typeof l.id !== 'string' || l.id === '') return bad(file, `card ${card} has no id`);
        if (typeof l.title !== 'string' || l.title === '') return bad(file, `card ${card} has no title`);
        let linkMode = '';
        if (l.mode !== undefined && l.mode !== null && l.mode !== '') {
          if (MODES.has(l.mode)) linkMode = l.mode;
          else return bad(file, `card ${card} mode is not a Mode`);
        }
        const n = (occurrences.get(l.id) || 0) + 1;
        occurrences.set(l.id, n);
        usedKeys.add(l.id);

        const isAdult = l.isAdult === true;
        const hasEntry = Object.hasOwn(secrets, l.id);
        let destination = null;
        if (isAdult && !hasEntry) notes.push(`no destination: ${username} card ${card}`);
        else {
          if (!isAdult && hasEntry) {
            notes.push(`dropped: ${username} card ${card}: secrets entry ${l.id} unused, a non-Adult Link keeps its own url`);
          }
          destination = isAdult ? secrets[l.id] : rootRelative(l.url);
          if (typeof destination !== 'string' || !DESTINATION.test(destination)) {
            return bad(file, `card ${card}: its Destination is neither an absolute http(s) URL nor a root-relative path`);
          }
        }

        planned.push({
          v1Key: `${l.id}#${n}`,
          title: l.title,
          order: i,
          isAdult,
          mode: linkMode,
          destination,
          tracking: l.tracking === true,
          defaultTrackingCode: typeof l.default_tracknumber === 'string' ? l.default_tracknumber : '',
          geo: isObject(l.geo) ? l.geo : null,
          icon: image(file, `card ${card} icon`, l.icon),
          backgroundImage: image(file, `card ${card} backgroundImage`, l.backgroundImage),
        });
      });

      profiles.push({
        username,
        v1Key: name,
        displayName,
        bio: typeof p.bio === 'string' ? p.bio : '',
        verified: p.verified === true,
        avatar: image(file, 'avatarUrl', p.avatarUrl),
        mode,
        links: planned,
      });
    }

    for (const key of Object.keys(secrets)) {
      if (!usedKeys.has(key)) notes.push(`dropped: secrets entry ${key} has no Link`);
    }
  }
  return { problems, notes, profiles };
}

// The write phase: as the superuser, through PocketBase's REST API (PB_URL, PB_SUPERUSER_EMAIL, PB_SUPERUSER_PASSWORD).
// Each Profile is created with its Mode, then its Links in file order; PocketBase mints each Link's linkId on create.
// Images go up byte for byte as multipart files. Any failure throws a WriteError whose message is a fixed reason
// naming at most a Username and card position, never a PocketBase response body (it can hold a Destination).
// ASSUMPTION: records are only created here; a re-run against a stack that already holds a Profile fails with exit 2. Matching on re-runs comes in ticket 19 (rung 5). Overturned if the seed must run twice on one stack before 19.
class WriteError extends Error {}

async function write(profiles) {
  // compose.yaml sets PB_URL for the app service; there is no fallback here.
  const base = process.env.PB_URL;
  const email = process.env.PB_SUPERUSER_EMAIL;
  const password = process.env.PB_SUPERUSER_PASSWORD;
  if (!base || !email || !password) throw new WriteError('PB_URL, PB_SUPERUSER_EMAIL and PB_SUPERUSER_PASSWORD are not all set');

  // `step` names the call; the reason appended to it is fixed text.
  const call = async (step, pathname, init) => {
    let res;
    try {
      res = await fetch(base + pathname, init);
    } catch {
      throw new WriteError(`${step}: PocketBase unreachable`);
    }
    if (!res.ok) {
      await res.body?.cancel();
      throw new WriteError(`${step} refused`);
    }
    try {
      return await res.json();
    } catch {
      throw new WriteError(`${step}: unreadable answer`);
    }
  };

  const auth = await call('superuser sign-in', '/api/collections/_superusers/auth-with-password', {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ identity: email, password }),
  });
  const headers = { Authorization: auth.token };

  let images = 0;
  const attach = (form, field, file) => {
    if (!file) return;
    form.append(field, new Blob([fs.readFileSync(file)], { type: 'image/webp' }), path.basename(file));
    images += 1;
  };
  const create = (step, collection, form) =>
    call(step, `/api/collections/${collection}/records`, { method: 'POST', headers, body: form });

  let links = 0;
  for (const p of profiles) {
    const form = new FormData();
    form.append('username', p.username);
    form.append('displayName', p.displayName);
    form.append('bio', p.bio);
    form.append('verified', String(p.verified));
    form.append('mode', p.mode);
    form.append('v1Key', p.v1Key);
    attach(form, 'avatar', p.avatar);
    const record = await create(`profile ${p.username}`, 'profiles', form);

    for (const [i, l] of p.links.entries()) {
      const lf = new FormData();
      lf.append('profile', record.id);
      lf.append('title', l.title);
      lf.append('order', String(l.order));
      lf.append('isAdult', String(l.isAdult));
      lf.append('mode', l.mode);
      lf.append('destination', l.destination ?? '');
      lf.append('tracking', String(l.tracking));
      lf.append('defaultTrackingCode', l.defaultTrackingCode);
      if (l.geo) lf.append('geo', JSON.stringify(l.geo));
      lf.append('v1Key', l.v1Key);
      attach(lf, 'icon', l.icon);
      attach(lf, 'backgroundImage', l.backgroundImage);
      await create(`${p.username} card ${i + 1}`, 'links', lf);
      links += 1;
    }
  }
  return { profiles: profiles.length, links, images };
}

async function main() {
  const sites = parseArgs(process.argv.slice(2));
  if (!sites) {
    console.error('usage: import-v1 --site <dir> [--site <dir>]...');
    process.exitCode = 1;
    return;
  }
  const { problems, notes, profiles } = planImport(sites);
  if (problems.length) {
    for (const line of problems) console.error(line);
    process.exitCode = 1;
    return;
  }
  for (const line of notes) console.log(line);
  let counts;
  try {
    counts = await write(profiles);
  } catch (e) {
    // A fixed reason only: a PocketBase error body can hold a Destination.
    console.error(`write failed: ${e instanceof WriteError ? e.message : 'PocketBase write did not complete'}`);
    process.exitCode = 2;
    return;
  }
  console.log(`imported: ${counts.profiles} Profiles, ${counts.links} Links, ${counts.images} images, ${notes.length} warnings`);
}

// The error is never printed: Node's own report would show its properties, and a URL error's `input` is the url.
main().catch(() => {
  console.error('import-v1: stopped by an unexpected error; nothing was written');
  process.exitCode = 1;
});
