# Test-only values for the e2e stack (docker compose --env-file tests/e2e.env ...). No real credential.
COMPOSE_PROJECT_NAME=oflinkv2-e2e
SITE_ADDRESS=:80
HTTP_PORT=4173
HTTPS_PORT=4443
PB_PORT=18090
PB_SUPERUSER_EMAIL=e2e-superuser@example.com
PB_SUPERUSER_PASSWORD=e2e-throwaway-password
REVEAL_LIMIT_PER_MINUTE=600
# The baseURL's host is the test stack's one primary host; the `.test` names are listed by 05-domains as it runs.
PRIMARY_HOSTS=localhost
# Caddy's PROXY protocol flag stays off here: no proxy fronts the test stack (tests/proxy-protocol.sh turns it on).
PROXY_PROTOCOL_FROM=
# The Cloudflare lines stay off here: the parity and Stats specs inject location headers locally (tests/cloudflare-lines.sh
# turns them on).
CLOUDFLARE_RANGES=
# The test stack is compose.yaml plus the local mail catcher, whose `mail` profile only tests/stack.sh turns on.
COMPOSE_FILE=compose.yaml:tests/compose.mail.yaml
# The local mail catcher's HTTP API on loopback (tests/compose.mail.yaml); PocketBase reaches its SMTP inside the stack.
MAILPIT_PORT=18025
# Phase 4's seeded Creators (tests/stats-seed.js): test-only passwords for the Stats Creator and the Other Creator.
STATS_CREATOR_PASSWORD=e2e-stats-creator-password
OTHER_CREATOR_PASSWORD=e2e-other-creator-password
